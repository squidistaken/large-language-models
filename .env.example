# Copy to `.env` and fill in what is needed.

# Hugging Face
HF_TOKEN=
# HF_HOME=/scratch/<s-number>/hf-cache # Model cache; on Hábrók the jobs default to /scratch/$USER/hf-cache

# Weights & Biases
# Online runs need this key (https://wandb.ai/authorize) or a verified `wandb login`.
WANDB_API_KEY=
WANDB_MODE=disabled # Options: online | offline | disabled (empty counts as disabled)
WANDB_ENTITY= # The W&B team (or user) to log to; empty = your default entity
WANDB_PROJECT=large-language-models
# WANDB_DIR=/scratch/<s-number>/wandb

# uv
# UV_CACHE_DIR=/scratch/<s-number>/uv-cache # Default: OS cache dir
